# ─── LLM Provider (groq, openai, huggingface) ─────────────────────────────────
LLM_PROVIDER=groq

# ─── Groq ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here
PRIMARY_MODEL=llama-3.3-70b-versatile
FALLBACK_MODEL=llama-3.1-8b-instant

# ─── HuggingFace (Required if LLM_PROVIDER=huggingface) ───────────────────────
HF_TOKEN=hf_your_token_here

# ─── LangSmith Tracing (Recommended) ──────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=lsv2_pt_your_key_here
LANGCHAIN_PROJECT="verification-in-the-loop-cti"

# ─── Paths ────────────────────────────────────────────────────────────────────
DATA_DIR=data

# ─── Local Models ─────────────────────────────────────────────────────────────
# These run locally on CPU via sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
